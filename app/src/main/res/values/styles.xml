        <item name="color">@color/primary</item>
    </style>

    <!-- Estilo dos cards -->
    <style name="Widget.Volt_Project.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">14dp</item>
