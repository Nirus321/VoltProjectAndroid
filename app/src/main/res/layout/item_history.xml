<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:background="@drawable/bg_history"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_marginBottom="30dp"
    android:padding="20dp">

    <ImageView
        android:id="@+id/imageActivity"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:backgroundTint="@color/primary"
        android:src="@drawable/ic_running_p"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="September 30, 2025"
        android:textColor="@color/muted_foreground"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/imageActivity"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvKm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="000.00 km"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="@color/muted_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvKm" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="ViewDetails"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageActivity" />

    <ImageView
        android:id="@+id/magicBtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:layout_marginTop="25dp"
        android:src="@drawable/ic_arrow_down_red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTime" />

    <TextView
        android:id="@+id/resLbl0"
        android:visibility="gone"
        android:textSize="13sp"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:text="Calories"
        android:textColor="@color/muted_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView12" />

    <TextView
        android:id="@+id/resVal0"
        android:visibility="gone"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="0 kcal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resLbl0" />

    <TextView
        android:id="@+id/resLbl1"
        android:visibility="gone"
        android:layout_width="45dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:layout_marginStart="58dp"
        android:layout_marginTop="40dp"
        android:text="Pace"
        android:textColor="@color/muted_foreground"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/resLbl0"
        app:layout_constraintTop_toBottomOf="@+id/textView12" />


    <TextView
        android:id="@+id/resVal1"
        android:visibility="gone"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="00:00 /km"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/resVal0"
        app:layout_constraintTop_toBottomOf="@+id/resLbl1" />

    <TextView
        android:id="@+id/resLbl2"
        android:visibility="gone"
        android:gravity="center"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="40dp"
        android:text="Steps"
        android:textColor="@color/muted_foreground"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/resLbl1"
        app:layout_constraintTop_toBottomOf="@+id/textView12" />

    <TextView
        android:id="@+id/resVal2"
        android:visibility="gone"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="0000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/resVal1"
        app:layout_constraintTop_toBottomOf="@+id/resLbl2" />


</androidx.constraintlayout.widget.ConstraintLayout>