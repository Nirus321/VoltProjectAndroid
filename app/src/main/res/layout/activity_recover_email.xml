<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="@dimen/space_6"
        android:gravity="center_horizontal"
        android:layout_marginTop="60dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logo" />

        <!-- Título -->
        <TextView
            android:text="Recover Password"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="315dp" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:text="Insert your email so you may receive a link to recover your account"
            android:textColor="@color/muted_foreground"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="315dp" />

        <!-- Campo Email -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:id="@+id/tilEmail"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_mail"
                app:startIconTint="@color/primary"
                app:boxStrokeColor="@color/input_stroke_color"
                app:boxBackgroundColor="@color/muted"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxBackgroundMode="outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_and_button_height"
                android:layout_marginTop="@dimen/space_6"
                android:maxWidth="315dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:includeFontPadding="false"
                    android:textColor="@color/foreground"
                    android:textColorHint="@color/muted_foreground"
                    android:paddingStart="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Botão Send -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:text="Send"
            android:backgroundTint="@color/primary"
            android:textColor="@color/primary_foreground"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_6"
            app:cornerRadius="10dp"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:maxWidth="315dp" />

        <!-- Texto “I remember now!! Back to Login” -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="I remember now!! "
                android:textColor="@color/foreground"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:text="Back to Login"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
