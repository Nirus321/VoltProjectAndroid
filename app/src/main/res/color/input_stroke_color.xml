<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Quando desativado -->
    <item android:state_enabled="false" android:color="@color/muted_foreground" />
    <!-- Quando focado -->
    <item android:state_focused="true" android:color="@color/primary" />
    <!-- Estado normal (não focado) -->
    <item android:color="@color/border" />
</selector>
