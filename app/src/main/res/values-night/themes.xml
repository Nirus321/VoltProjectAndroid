<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Volt_Project" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColor">@color/foreground</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/destructive</item>
        <item name="colorOnPrimary">@color/primary_foreground</item>

        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
    </style>

    <style name="Theme.Volt_Project.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Volt_Project.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Volt_Project.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
